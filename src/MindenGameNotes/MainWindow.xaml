<Window x:Class="MindenGameNotes.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Minden Game Notes Builder" Width="1380" Height="880" MinWidth="1050" MinHeight="680" Background="#F2F4F7">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource Navy}" Padding="22,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="MINDEN" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock Text="GAME NOTES BUILDER  /  V1" Foreground="#C9D2DF"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Import PDF / Excel" Click="Import_Click"/><Button Content="Save" Click="Save_Click"/><Button Content="Export 8-page PDF" Background="{StaticResource Crimson}" Foreground="White" BorderThickness="0" Click="Export_Click"/></StackPanel>
      </Grid>
    </Border>
    <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="440"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TabControl Grid.Column="0">
        <TabItem Header="Weekly editor"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
          <TextBlock Text="MATCHUP" FontWeight="Bold" Foreground="{StaticResource Crimson}"/><TextBlock Text="Opponent"/><TextBox Text="{Binding Opponent, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Game date"/><DatePicker SelectedDate="{Binding GameDate}" Margin="0,3,0,9"/><TextBlock Text="Venue"/><TextBox Text="{Binding Venue, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Week"/><TextBox Text="{Binding PageOne.Week, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Kickoff"/><TextBox Text="{Binding PageOne.Kickoff, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Weather"/><TextBox Text="{Binding PageOne.Weather, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Headline"/><TextBox Text="{Binding Headline, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="EDITORIAL" FontWeight="Bold" Foreground="{StaticResource Crimson}" Margin="0,14,0,0"/><TextBlock Text="Storyline"/><TextBox Text="{Binding Storyline, UpdateSourceTrigger=PropertyChanged}" Height="120" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Coach quote"/><TextBox Text="{Binding CoachQuote, UpdateSourceTrigger=PropertyChanged}" Height="90" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Media contact"/><TextBox Text="{Binding MediaContact, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Verify data"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Imported rows remain unverified until reviewed." TextWrapping="Wrap" Margin="2,3,2,9"/><DataGrid Grid.Row="1" ItemsSource="{Binding Players}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="OK" Binding="{Binding Verified}"/><DataGridTextColumn Header="#" Binding="{Binding Number}"/><DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Pos" Binding="{Binding Position}"/><DataGridTextColumn Header="GP" Binding="{Binding Games}"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" Content="Mark all verified" HorizontalAlignment="Left" Margin="0,10,0,0" Click="VerifyAll_Click"/></Grid></TabItem>
        <TabItem Header="Import history"><DataGrid Margin="10" ItemsSource="{Binding Imports}" IsReadOnly="True" AutoGenerateColumns="True"/></TabItem>
      </TabControl>
      <Border Grid.Column="2" Background="#DDE2E8" CornerRadius="4"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="DOCUMENT PREVIEW" FontWeight="Bold" Foreground="{StaticResource Navy}" Margin="18,14"/><ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="PreviewPages" Margin="18"/></ScrollViewer><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10"><TextBlock x:Name="StatusText" Text="Ready" Foreground="#566070"/></StackPanel></Grid></Border>
    </Grid>
  </DockPanel>
</Window>
