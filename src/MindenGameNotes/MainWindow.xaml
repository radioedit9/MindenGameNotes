<Window x:Class="MindenGameNotes.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Minden Game Notes Information Builder" Width="1450" Height="900" MinWidth="1100" MinHeight="700" Background="#F2F4F7">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource Navy}" Padding="22,14">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="MINDEN" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock Text="GAME NOTES INFORMATION BUILDER" Foreground="#C9D2DF"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="ProjectSelector" Width="300" DisplayMemberPath="DisplayName" SelectionChanged="ProjectSelector_SelectionChanged"/><Button Content="New Week" Click="NewProject_Click"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Save" Click="Save_Click"/><Button Content="Export legacy diagnostic PDF" Click="Export_Click"/></StackPanel>
      </Grid>
    </Border>
    <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="610"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TabControl Grid.Column="0">
        <TabItem Header="Weekly project"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
          <TextBlock Text="CANONICAL WEEKLY IDENTITY" FontWeight="Bold" Foreground="{StaticResource Crimson}"/>
          <UniformGrid Columns="2"><StackPanel Margin="0,0,8,0"><TextBlock Text="Season"/><TextBox Text="{Binding Season, UpdateSourceTrigger=LostFocus}"/></StackPanel><StackPanel><TextBlock Text="Week"/><TextBox Text="{Binding Week, UpdateSourceTrigger=LostFocus}"/></StackPanel></UniformGrid>
          <TextBlock Text="Opponent"/><TextBox Text="{Binding Opponent, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Game date"/><DatePicker SelectedDate="{Binding GameDate}" Margin="0,3,0,9"/>
          <TextBlock Text="Kickoff time"/><TextBox Text="{Binding KickoffText, UpdateSourceTrigger=LostFocus}" ToolTip="Example: 7:00 PM"/>
          <TextBlock Text="Venue / location"/><TextBox Text="{Binding Venue, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"/>
          <TextBlock Text="EDITORIAL (LEGACY COMPATIBILITY)" FontWeight="Bold" Foreground="{StaticResource Crimson}" Margin="0,14,0,0"/><TextBlock Text="Storyline"/><TextBox Text="{Binding Storyline, UpdateSourceTrigger=PropertyChanged}" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Coach quote"/><TextBox Text="{Binding CoachQuote, UpdateSourceTrigger=PropertyChanged}" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Source configuration"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DataGrid x:Name="SourceFamiliesGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"><DataGrid.Columns><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}"/><DataGridTextColumn Header="Source family" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="Local/Dropbox root path" Binding="{Binding RootPath}" Width="*"/></DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Add family" Click="AddFamily_Click"/><Button Content="Browse root" Click="BrowseFamily_Click"/></StackPanel>
        </Grid></TabItem>
        <TabItem Header="Expected sources"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DataGrid x:Name="ExpectedDocumentsGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"><DataGrid.Columns>
            <DataGridTextColumn Header="Document" Binding="{Binding Name}" Width="150"/><DataGridComboBoxColumn x:Name="SourceFamilyColumn" Header="Source family" SelectedValueBinding="{Binding SourceFamilyId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="150"/><DataGridCheckBoxColumn Header="Applies" Binding="{Binding IsApplicable}"/><DataGridCheckBoxColumn Header="Pending" Binding="{Binding IsPending}"/><DataGridCheckBoxColumn Header="Single-game" Binding="{Binding IsSingleGameReport}"/><DataGridTextColumn Header="Expected locator" Binding="{Binding ExpectedLocator}" Width="160"/><DataGridTextColumn Header="Expected as of (UTC)" Binding="{Binding ExpectedAsOfUtc}" Width="130"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="90"/><DataGridTextColumn Header="Verification" Binding="{Binding Verification}" IsReadOnly="True" Width="90"/>
          </DataGrid.Columns></DataGrid>
          <WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button Content="Add expected document" Click="AddDocument_Click"/><Button Content="Resolve file" Click="ResolveDocument_Click"/><Button Content="Refresh status" Click="RefreshDocument_Click"/><Button Content="Verify / unverify" Click="VerifyDocument_Click"/><Button Content="Import selected" Click="Import_Click"/></WrapPanel>
        </Grid></TabItem>
        <TabItem Header="Game Stats intake"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="160"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><WrapPanel><Button Content="Import selected single-game PDF" Click="ImportSingleGame_Click"/><Button x:Name="AcceptGameReportButton" Content="Accept Report" Click="AcceptGameReport_Click"/><Button x:Name="ReplaceGameReportButton" Content="Replace Accepted Report" Click="ReplaceGameReport_Click"/><Button Content="Reject Report" Click="RejectGameReport_Click"/></WrapPanel><TextBlock x:Name="LinkedSourceStateText" Margin="2,5,2,4" TextWrapping="Wrap"/></StackPanel>
          <DataGrid Grid.Row="1" x:Name="StagedGameReportsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="StagedGameReportsGrid_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="State" Binding="{Binding State}"/><DataGridTextColumn Header="Opponent" Binding="{Binding Opponent}" Width="*"/><DataGridTextColumn Header="Date" Binding="{Binding GameDate, StringFormat=d}"/><DataGridTextColumn Header="Minden" Binding="{Binding MindenScore}"/><DataGridTextColumn Header="Opponent" Binding="{Binding OpponentScore}"/><DataGridTextColumn Header="Issues" Binding="{Binding Issues.Count}"/></DataGrid.Columns></DataGrid>
          <TextBox Grid.Row="2" x:Name="StagedReportDetails" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
          <WrapPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock Text="Correction field" VerticalAlignment="Center"/><ComboBox x:Name="CorrectionField" Width="175" SelectedIndex="0" IsEditable="True" ToolTip="Summary field, or e.g. TeamStatistic:TotalOffense:Minden / Rushing:Jardon Carey:Yards"><ComboBoxItem Content="Opponent"/><ComboBoxItem Content="GameDate"/><ComboBoxItem Content="Site"/><ComboBoxItem Content="MindenScore"/><ComboBoxItem Content="OpponentScore"/></ComboBox><TextBlock Text="Value" VerticalAlignment="Center"/><TextBox x:Name="CorrectionValue" Width="150"/><TextBlock Text="Note" VerticalAlignment="Center"/><TextBox x:Name="ReviewNote" Width="250"/><Button Content="Apply correction" Click="CorrectGameReport_Click"/></WrapPanel>
          <TextBlock Grid.Row="4" x:Name="AcceptedSupplyText" Margin="2,8,2,0" TextWrapping="Wrap" FontWeight="Bold"/>
        </Grid></TabItem>
        <TabItem Header="Verify player data"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Player-row verification is separate from WP 1 project readiness." TextWrapping="Wrap" Margin="2,3,2,9"/><DataGrid Grid.Row="1" ItemsSource="{Binding Players}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="OK" Binding="{Binding Verified}"/><DataGridTextColumn Header="#" Binding="{Binding Number}"/><DataGridTextColumn Header="Player" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Pos" Binding="{Binding Position}"/><DataGridTextColumn Header="GP" Binding="{Binding Games}"/></DataGrid.Columns></DataGrid><Button Grid.Row="2" Content="Mark all player rows verified" HorizontalAlignment="Left" Margin="0,10,0,0" Click="VerifyAll_Click"/></Grid></TabItem>
        <TabItem Header="Import history"><DataGrid Margin="10" ItemsSource="{Binding Imports}" IsReadOnly="True" AutoGenerateColumns="True"/></TabItem>
      </TabControl>
      <Border Grid.Column="2" Background="#DDE2E8" CornerRadius="4"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="18,14"><TextBlock Text="WP 1 READINESS" FontWeight="Bold" Foreground="{StaticResource Navy}"/><TextBlock x:Name="ReadinessText" FontSize="18" FontWeight="Bold"/><ItemsControl x:Name="ReadinessIssues"/></StackPanel>
        <TextBlock Grid.Row="1" Text="LEGACY DIAGNOSTIC PREVIEW (NON-AUTHORITATIVE)" FontWeight="Bold" Foreground="{StaticResource Navy}" Margin="18,6"/>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="PreviewPages" Margin="18"/></ScrollViewer>
        <TextBlock Grid.Row="3" x:Name="StatusText" Text="Ready" Foreground="#566070" HorizontalAlignment="Center" Margin="10"/>
      </Grid></Border>
    </Grid>
  </DockPanel>
</Window>
